# Dependencies — Vercel installs these itself
node_modules/

# Build output — Vercel builds this itself
dist/

# Environment variables — NEVER commit secrets
.env
.env.local
.env.*.local

# macOS system files
.DS_Store
.AppleDouble
.LSOverride

# Editor swap / temp files
*.swp
*.swo
*~

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# TypeScript cache
*.tsbuildinfo

# Python bytecode
__pycache__/
*.pyc
*.pyo
